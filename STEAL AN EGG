--// Utilitários
local function safeParent(gui)
    if gethui then
        return gethui()
    elseif CoreGui then
        return CoreGui
    else
        return LocalPlayer:WaitForChild("PlayerGui")
    end
end

local function getRarityColor(rarity)
    if not rarity then return CONFIG.DefaultRarityColor end
    for k, v in pairs(CONFIG.RarityColors) do
        if string.find(string.lower(tostring(rarity)), string.lower(k)) then
            return v
        end
    end
    return CONFIG.DefaultRarityColor
end

local function getEggRarity(egg)
    local rarity = nil
    pcall(function()
        if egg:GetAttribute("Rarity") then rarity = egg:GetAttribute("Rarity") end
        if not rarity and egg:FindFirstChild("Rarity") then
            rarity = egg.Rarity.Value or egg.Rarity
        end
        if not rarity and egg:GetAttribute("rarity") then rarity = egg:GetAttribute("rarity") end
    end)
    return rarity
end

local function getEggName(egg)
    return egg.Name
end

local function getEggPosition(egg)
    if egg:IsA("BasePart") then return egg.Position end
    if egg:IsA("Model") then
        local primary = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
        if primary then return primary.Position end
    end
    return nil
end

local function distanceTo(pos)
    if not pos then return math.huge end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return math.huge end
    return (hrp.Position - pos).Magnitude
end

local function teleportTo(pos)
    if not pos then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    end
end

--// Coleta de ovos
local function scanEggs()
    local found = {}
    local seen = {}
    for _, folderName in ipairs(CONFIG.EggFolderNames) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("BasePart") or child:IsA("Model") then
                    if not seen[child] then
                        seen[child] = true
                        local pos = getEggPosition(child)
                        if pos then
                            table.insert(found, {
                                Instance = child,
                                Name = getEggName(child),
                                Rarity = getEggRarity(child),
                                Position = pos,
                            })
                        end
                    end
                end
            end
        end
    end
    
    -- Fallback: varre Workspace por atributos "Egg"
    if #found == 0 then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:GetAttribute("IsEgg") or obj:GetAttribute("Egg") then
                local pos = getEggPosition(obj)
                if pos then
                    table.insert(found, {
                        Instance = obj,
                        Name = getEggName(obj),
                        Rarity = getEggRarity(obj),
                        Position = pos,
                    })
                end
            end
        end
    end
    return found
end

