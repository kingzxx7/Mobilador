    --// ESP Render Loop
    local function renderESP()
        if not State.ESPEnabled then return end
        local existing = {}
        for _, egg in ipairs(State.Eggs) do
            local key = egg.Instance
            existing[key] = true
            if not State.ESPObjects[key] then
                local billboard = Instance.new("BillboardGui")
                billboard.Size = UDim2.new(0, 150, 0, 50)
                billboard.AlwaysOnTop = true
                billboard.StudsOffset = Vector3.new(0, 3, 0)
                billboard.Adornee = egg.Instance:IsA("BasePart") and egg.Instance or (egg.Instance.PrimaryPart or egg.Instance:FindFirstChildWhichIsA("BasePart"))
                if not billboard.Adornee then billboard.Adornee = egg.Instance end
                billboard.Parent = safeParent()
                
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.TextColor3 = getRarityColor(egg.Rarity)
                lbl.TextStrokeTransparency = 0
                lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
                lbl.TextSize = 14
                lbl.Font = Enum.Font.GothamBold
                lbl.Parent = billboard

                local highlight = Instance.new("Highlight")
                highlight.FillColor = getRarityColor(egg.Rarity)
                highlight.OutlineColor = Color3.new(1, 1, 1)
                highlight.FillTransparency = 0.5
                highlight.Adornee = egg.Instance
                highlight.Parent = safeParent()

                State.ESPObjects[key] = {gui = billboard, label = lbl, highlight = highlight}
            end
        end

        -- Remove ESP antigo
        for key, obj in pairs(State.ESPObjects) do
            if not existing[key] then
                if obj.gui then obj.gui:Destroy() end
                if obj.highlight then obj.highlight:Destroy() end
                State.ESPObjects[key] = nil
            end
        end

        -- Atualiza texto
        for key, obj in pairs(State.ESPObjects) do
            for _, egg in ipairs(State.Eggs) do
                if egg.Instance == key then
                    local parts = {}
                    if State.ESPName ~= false then table.insert(parts, egg.Name) end
                    if State.ESPDistance ~= false then
                        table.insert(parts, string.format("[%.0f]", distanceTo(egg.Position)))
                    end
                    if State.ESPRarity ~= false and egg.Rarity then
                        table.insert(parts, "(" .. tostring(egg.Rarity) .. ")")
                    end
                    obj.label.Text = table.concat(parts, " ")
                    break
                end
            end
        end
    end

    --// Auto Steal Loop
    task.spawn(function()
        while task.wait(State.AutoStealDelay) do
            if State.AutoStealEnabled then
                local nearest, ndist = nil, math.huge
                for _, egg in ipairs(State.Eggs) do
                    local d = distanceTo(egg.Position)
                    if d < ndist and d <= State.AutoStealRange then ndist = d; nearest = egg end
                end
                if nearest then
                    teleportTo(nearest.Position)
                    task.wait(0.1)
                    local cd = nearest.Instance:FindFirstChildWhichIsA("ClickDetector", true)
                    if cd then pcall(function() fireclickdetector(cd) end) end
                    if nearest.Instance:IsA("BasePart") then
                        pcall(function() nearest.Instance:Activate() end)
                    end
                end
            end
            renderESP()
        end
    end)

